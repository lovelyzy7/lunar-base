# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Lunar-base data: backups, master-data dumps, anything derived from the game
data/

# Compiled Go shim. Built locally by setup.bat / setup.sh against the user's
# lunar-tear checkout so the binary always matches their lunar-tear revision.
# Its SOURCES under tools/grant/src/ are tracked and must always be committed.
tools/grant/grant.exe
tools/grant/grant

# Prebuilt grant helpers (tools/grant/build_prebuilt.py). They are release
# assets, not history: six platforms are ~107 MB. config.py prefers them when
# present, so dropping one in is enough to run without a Go toolchain.
tools/grant/prebuilt/*
!tools/grant/prebuilt/README.md

# apktool jar: downloaded by setup on first use, not committed.
tools/apktool/

# Go test / coverage output
*.test
coverage.out

# Logs and scratch files
*.log
*.tmp
*.swp
*~

# IDE / OS
.vscode/
.idea/
Thumbs.db
.DS_Store
